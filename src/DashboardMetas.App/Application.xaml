<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DashboardMetas.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <conv:ToneToTextBrushConverter x:Key="ToneToText" />
            <conv:ToneToDotBrushConverter x:Key="ToneToDot" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />
            <conv:RatioToStarConverter x:Key="RatioToStar" />
            <conv:LevelToBrushConverter x:Key="LevelToBrush" />
            <conv:DiagnosticGlyphConverter x:Key="DiagnosticGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
