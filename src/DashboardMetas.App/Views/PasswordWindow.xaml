<Window x:Class="PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contraseña de JDE" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="True"
        Style="{StaticResource AppWindow}" Icon="pack://application:,,,/Resources/app.ico"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource DialogHeader}">
            <TextBlock Text="JD Edwards (AS400)" Style="{StaticResource DialogHeaderText}" />
        </Border>
        <StackPanel Grid.Row="1" Margin="22,16,22,6">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Margin="0,0,0,4"><Run Text="Usuario: " /><Bold><Run x:Name="UserText" /></Bold></TextBlock>
            <Label Content="_Contraseña" Target="{Binding ElementName=PasswordInput}" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Contraseña de JDE" />
            <CheckBox x:Name="RememberCheck" Content="_Recordar en esta PC (cifrada con Windows)" IsChecked="True" Margin="0,12,0,0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Recomendado para una pantalla que se actualiza sola: se guarda cifrada con DPAPI y solo tu usuario de Windows en esta PC puede leerla. Se borra en Configuración › Olvidar contraseña." />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,10,22,18">
            <Button Style="{StaticResource PrimaryButton}" Content="_Conectar" IsDefault="True" Width="110" Click="OnAccept" />
            <Button Content="Cancelar" IsCancel="True" Width="90" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
