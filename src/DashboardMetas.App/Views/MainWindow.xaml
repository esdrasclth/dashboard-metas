<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DashboardMetas.App.Controls"
        xmlns:vm="clr-namespace:DashboardMetas.App.ViewModels"
        xmlns:dash="clr-namespace:DashboardMetas.Core.Dashboard;assembly=DashboardMetas.Core"
        Title="Dashboard Metas" Width="1600" Height="900" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}"
        Background="{StaticResource BackgroundBrush}" Icon="pack://application:,,,/Resources/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextAreaCommand}" />
        <KeyBinding Key="Left" Command="{Binding PreviousAreaCommand}" />
        <KeyBinding Key="V" Command="{Binding ToggleOverviewCommand}" />
        <KeyBinding Key="M" Command="{Binding ToggleChartCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- KPI card: title, big value (shrinks to fit, never clipped) and a line below -->
        <DataTemplate x:Key="KpiLarge" DataType="{x:Type vm:KpiCard}">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource KpiTitle}" />
                    <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="58" FontWeight="Bold"
                                   Foreground="{Binding Tone, Converter={StaticResource ToneToText}}" />
                    </Viewbox>
                    <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource KpiSub}"
                               Foreground="{Binding SubtitleTone, Converter={StaticResource ToneToText}, ConverterParameter=muted}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KpiSmall" DataType="{x:Type vm:KpiCard}">
            <Border Style="{StaticResource Card}" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Title}" Style="{StaticResource KpiTitle}" />
                    <Viewbox Grid.Row="1" Grid.ColumnSpan="2" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold"
                                   Foreground="{Binding Tone, Converter={StaticResource ToneToText}}" />
                    </Viewbox>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource KpiSub}"
                               Foreground="{Binding SubtitleTone, Converter={StaticResource ToneToText}, ConverterParameter=muted}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- "Por día | Mes" toggle in the chart header; the selected one is navy -->
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <!-- Pace pill background: teal = goal met, light teal = on track, orange = behind, grey = the rest -->
        <Style x:Key="PacePill" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource PillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pace}" Value="{x:Static dash:PaceState.GoalMet}">
                    <Setter Property="Background" Value="{StaticResource TealBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pace}" Value="{x:Static dash:PaceState.OnTrack}">
                    <Setter Property="Background" Value="{StaticResource OnTrackBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pace}" Value="{x:Static dash:PaceState.Behind}">
                    <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Coloured stripe on the left of each tile, same meaning as the pill -->
        <Style x:Key="PaceStripe" TargetType="Border" BasedOn="{StaticResource PacePill}">
            <Setter Property="CornerRadius" Value="8,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- One area of the overview (clic = open its detail) -->
        <DataTemplate x:Key="AreaTile" DataType="{x:Type vm:AreaTileViewModel}">
            <Button Margin="12" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding DataContext.OpenAreaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Code}"
                    AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Style="{StaticResource Card}" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Border Style="{StaticResource PaceStripe}" />
                    <Grid Margin="30,20,26,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="40" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Center" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding AttainmentText}" FontFamily="{StaticResource DisplayFont}" FontSize="58" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            </Viewbox>
                            <Border Grid.Column="1" Style="{StaticResource PacePill}">
                                <TextBlock Text="{Binding PillText}" FontSize="14" FontWeight="Bold"
                                           Foreground="{Binding IsGoalMet, Converter={StaticResource BoolToBrush}, ConverterParameter='CardBrush|NavyBrush'}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding ValueText}" FontSize="18" Foreground="{StaticResource MutedBrush}" />
                        <Grid Grid.Row="3" Margin="0,10,0,6" Height="20">
                            <Grid Height="10" ClipToBounds="True">
                                <Border Background="#E3E8F0" CornerRadius="2" />
                                <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding AttainmentRatio}" />
                                    </Border.RenderTransform>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ProgressBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoalMet}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource TealBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <Grid IsHitTestVisible="False" Visibility="{Binding ShowPaceMarker, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding PaceMarkerRatio, Converter={StaticResource RatioToStar}, ConverterParameter=left}" />
                                    <ColumnDefinition Width="{Binding PaceMarkerRatio, Converter={StaticResource RatioToStar}, ConverterParameter=right}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="3" Background="{StaticResource NavyBrush}" CornerRadius="1" HorizontalAlignment="Left" Margin="-1.5,0,0,0" />
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="{Binding DetailText}" FontSize="16" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding DetailTone, Converter={StaticResource ToneToText}, ConverterParameter=muted}" />
                        <ctl:MiniBarChart Grid.Row="5" Margin="0,12,0,8" Snapshot="{Binding Snapshot}" />
                        <TextBlock Grid.Row="6" Text="{Binding MonthText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding MonthTone, Converter={StaticResource ToneToText}, ConverterParameter=muted}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,28,0" />
        </Style>

        <Style x:Key="LegendSwatch" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- Everything is laid out on a 1080-high design; the width follows the screen proportion (see code-behind) -->
        <Grid x:Name="DesignRoot" Width="1920" Height="1080">
            <Grid Margin="44,30,44,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="212" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================== Header ===================== -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="1150" />
                            <Border Background="{StaticResource WarnBackBrush}" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1.5"
                                    CornerRadius="4" Padding="14,4" Margin="20,6,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Labels.Demo}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OrangeTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="2,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource InkBrush}">
                            <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding ClockText, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" ToolTip="{Binding StatusDetail}">
                            <Ellipse x:Name="StatusDot" Width="14" Height="14" VerticalAlignment="Center" Fill="{Binding StatusTone, Converter={StaticResource ToneToDot}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding StatusTone, Converter={StaticResource ToneToText}}" />
                            <Button Content="{Binding Labels.Connect}" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}"
                                    FontSize="16" Padding="16,4" Margin="14,0,0,0"
                                    Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===================== Top KPIs ===================== -->
                <Grid Grid.Row="1" Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Today's attainment (navy) -->
                    <Border Background="{StaticResource NavyBrush}" CornerRadius="8" Padding="28,22">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#0D2554" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Labels.AttainmentTitle}" FontSize="17" FontWeight="Bold" Foreground="White" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AttainmentText}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Bold" Foreground="White" />
                                </Viewbox>
                                <Border Grid.Column="1" Style="{StaticResource PacePill}" Padding="14,5" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PillText}" FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding IsGoalMet, Converter={StaticResource BoolToBrush}, ConverterParameter='CardBrush|NavyBrush'}" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding AttainmentSubtitle}" FontSize="17" Foreground="{StaticResource OnNavyMutedBrush}" TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="12" VerticalAlignment="Center" ClipToBounds="True"
                                      ToolTip="{Binding AttainmentSubtitle}">
                                    <Border Background="{StaticResource RailBrush}" CornerRadius="2" />
                                    <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding AttainmentRatio}" />
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource ProgressBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGoalMet}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource TealBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                                <!-- White tick: where the bar should be at this hour of the shift -->
                                <Grid Height="22" VerticalAlignment="Center" IsHitTestVisible="False"
                                      Visibility="{Binding ShowPaceMarker, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding PaceMarkerRatio, Converter={StaticResource RatioToStar}, ConverterParameter=left}" />
                                        <ColumnDefinition Width="{Binding PaceMarkerRatio, Converter={StaticResource RatioToStar}, ConverterParameter=right}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Width="3" Background="White" CornerRadius="1" HorizontalAlignment="Left" Margin="-1.5,0,0,0" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding AttainmentGoal}" FontSize="15" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Column="2" Content="{Binding TodayCard}" ContentTemplate="{StaticResource KpiLarge}" Focusable="False" />
                    <ContentControl Grid.Column="4" Content="{Binding GapCard}" ContentTemplate="{StaticResource KpiLarge}" Focusable="False" />
                    <ContentControl Grid.Column="6" Content="{Binding WeekCard}" ContentTemplate="{StaticResource KpiLarge}" Focusable="False" />
                </Grid>

                <!-- ===================== Chart ===================== -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,24" Padding="28,20,24,14" Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0" ToolTip="M">
                                    <Button Content="{Binding Labels.ByDay}" Command="{Binding ShowDailyChartCommand}" Margin="0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonthChart}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding Labels.Month}" Command="{Binding ShowMonthChartCommand}" Margin="6,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonthChart}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding ChartTitle, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                    <Run Text="   " /><Run Text="{Binding ChartRange, Mode=OneWay}" FontSize="19" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                            </StackPanel>
                            <!-- Month legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsMonthChart, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle Width="22" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource TealBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LegendMonthActual}" Style="{StaticResource LegendText}" />
                                <Line X1="0" X2="22" Y1="0" Y2="0" Stroke="{StaticResource NavyBrush}" StrokeThickness="2.5" StrokeDashArray="1.6 1.2" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LegendMonthTarget}" Style="{StaticResource LegendText}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowMonthProjectionLegend, Converter={StaticResource BoolToVisibility}}">
                                    <Line X1="0" X2="22" Y1="0" Y2="0" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.5" StrokeDashArray="1.6 1.2" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LegendMonthProjection}" Style="{StaticResource LegendText}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Daily legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsMonthChart, Converter={StaticResource InverseBoolToVisibility}}">
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource TealBrush}" />
                                <TextBlock Text="{Binding LegendMet}" Style="{StaticResource LegendText}" />
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource OrangeBrush}" />
                                <TextBlock Text="{Binding LegendBelow}" Style="{StaticResource LegendText}" />
                                <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource GreyBarBrush}" />
                                <TextBlock Text="{Binding LegendToday}" Style="{StaticResource LegendText}" Margin="8,0,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="28,0,0,0" Visibility="{Binding ShowProjectionLegend, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Width="18" Height="18" RadiusX="3" RadiusY="3" Stroke="{StaticResource MutedBrush}" StrokeThickness="2"
                                               StrokeDashArray="2 1.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LegendProjection}" Style="{StaticResource LegendText}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <ctl:DailyBarChart Grid.Row="1" Margin="0,6,0,0" Snapshot="{Binding Snapshot}" English="{Binding English}"
                                           AutomationProperties.Name="{Binding ChartTitle}"
                                           Visibility="{Binding IsMonthChart, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ctl:MonthChart Grid.Row="1" Margin="0,6,0,0" Snapshot="{Binding MonthSnapshot}" English="{Binding English}"
                                        AutomationProperties.Name="{Binding ChartTitle}"
                                        Visibility="{Binding IsMonthChart, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <!-- ===================== Bottom KPIs ===================== -->
                <Grid Grid.Row="3" Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding LastClosedCard}" ContentTemplate="{StaticResource KpiSmall}" Focusable="False" />
                    <ContentControl Grid.Column="2" Content="{Binding AverageCard}" ContentTemplate="{StaticResource KpiSmall}" Focusable="False" />
                    <ContentControl Grid.Column="4" Content="{Binding DaysOnGoalCard}" ContentTemplate="{StaticResource KpiSmall}" Focusable="False" />
                    <ContentControl Grid.Column="6" Content="{Binding MonthCard}" ContentTemplate="{StaticResource KpiSmall}" Focusable="False" />
                </Grid>

                <!-- ===================== Overview: all areas at once ===================== -->
                <ItemsControl Grid.Row="1" Grid.RowSpan="3" Margin="-12,-12,-12,0" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource AreaTile}"
                              Focusable="False" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding TileColumns}" Rows="{Binding TileRows}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ===================== Footer ===================== -->
                <Grid Grid.Row="4" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" FontSize="16">
                            <Run Text="{Binding FooterGoal, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <Run Text="  " /><Run Text="{Binding FooterInfo, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding AreaDots}" Margin="0,8,0,0" Focusable="False"
                                      Visibility="{Binding AreaDots, Converter={StaticResource EmptyToCollapsed}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" Fill="{Binding Converter={StaticResource BoolToBrush}, ConverterParameter='NavyBrush|LineBrush'}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding ViewToggleText}" Command="{Binding ToggleOverviewCommand}" ToolTip="V" Style="{StaticResource FooterButton}"
                                Margin="0,0,24,0" BorderBrush="{StaticResource NavyBrush}" BorderThickness="1.5" />
                        <TextBlock Text="{Binding Labels.Area}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}" Command="{Binding ChangeAreaCommand}" ToolTip="{Binding Labels.ChangeArea}" FontSize="17" FontWeight="SemiBold" Padding="18,9"
                                MinWidth="270" HorizontalContentAlignment="Stretch" BorderBrush="{StaticResource NavyBrush}" BorderThickness="1.5">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="▾" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding AreaButtonText}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <Button Content="{Binding Labels.Data}" ToolTip="{Binding Labels.DataTip}" Command="{Binding DataCommand}" Style="{StaticResource FooterButton}" Margin="24,0,0,0" Visibility="{Binding IsOverview, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="{Binding Labels.Settings}" ToolTip="{Binding Labels.SettingsTip}" Command="{Binding SettingsCommand}" Style="{StaticResource FooterButton}" />
                        <Button Content="{Binding Labels.Refresh}" ToolTip="F5" Command="{Binding RefreshCommand}" Style="{StaticResource FooterPrimaryButton}" />
                        <Button x:Name="FullScreenButton" Content="⛶" ToolTip="{Binding Labels.FullScreenTip}" Click="OnToggleFullScreen" Style="{StaticResource FooterButton}" Padding="16,9" />
                        <Button Content="{Binding Labels.ExitText}" Command="{Binding ExitCommand}" Style="{StaticResource FooterButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
