<Window x:Class="DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DashboardMetas.App.Services"
        Title="Diagnóstico" Width="780" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Style="{StaticResource AppWindow}" Icon="pack://application:,,,/Resources/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource DialogHeader}">
            <DockPanel>
                <TextBlock Text="Diagnóstico" Style="{StaticResource DialogHeaderText}" />
                <TextBlock Text="Para soporte: no guarda nada" Foreground="#C6D2E9" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ListView Grid.Row="1" ItemsSource="{Binding Items}" Margin="18,12,18,0" BorderBrush="{StaticResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Resultados del diagnóstico">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:DiagnosticItem}">
                    <Grid Margin="4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Level, Converter={StaticResource DiagnosticGlyph}}" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border Grid.Row="2" Margin="18,10,18,0" Padding="10,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Probar conexión" Command="{Binding TestConnectionCommand}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectionResult}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{Binding ConnectionLevel, Converter={StaticResource LevelToBrush}}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="18,12,18,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="_Actualizar" Command="{Binding RefreshCommand}" />
                <Button Content="_Copiar al portapapeles" Command="{Binding CopyCommand}" Margin="8,0,0,0" ToolTip="Para enviarlo a soporte por correo o chat" />
            </StackPanel>
            <Button Content="Cerrar" IsCancel="True" Width="90" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
